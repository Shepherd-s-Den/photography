{
  "openapi": "3.1.0",
  "info": {
    "title": "Photography album API",
    "version": "1.0.0",
    "description": "Same-origin REST API. JSON responses use application/json. Unmatched /api requests return 404 with {\"code\":\"not_found\"}."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/albums": {
      "get": {
        "operationId": "listAlbums",
        "summary": "List album metadata newest-first",
        "description": "Orders by creation time descending, then ID descending. Values below 1 select the first page; values above the available range select the last page. An empty collection returns page 1 with totalPages 0.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Supply at most once as a 32-bit integer. Malformed, valueless or repeated parameters return 400.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": -2147483648,
              "maximum": 2147483647,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Selected six-album page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AlbumPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailure" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      },
      "post": {
        "operationId": "createAlbum",
        "summary": "Create an album",
        "description": "Requires an unused immutable year and generates Journey of the Shepherds <year> as the initial title. Atomically creates an empty synopsis, the lowest-ID AlbumStart template's slots with empty placements, and both empty cover sides. The server assigns a stable UUID and immutable UTC creation time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["year"],
                "properties": {
                  "year": { "$ref": "#/components/schemas/AlbumYear" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/AlbumSummary" },
          "400": { "$ref": "#/components/responses/ValidationFailure" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/api/albums/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Canonical hyphenated UUID, case-insensitive on album metadata operations. Malformed and unknown IDs share the album_not_found response; returned IDs are lowercase.",
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "operationId": "getAlbum",
        "summary": "Read album metadata without composition",
        "responses": {
          "200": {
            "description": "Album title, synopsis and immutable metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AlbumMetadata" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/AlbumNotFound" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      },
      "patch": {
        "operationId": "renameAlbum",
        "summary": "Rename an album",
        "description": "Accepts any nonblank title, trimming surrounding whitespace. Changes only the title; year, identity, creation time, synopsis and composition remain unchanged.",
        "requestBody": { "$ref": "#/components/requestBodies/Title" },
        "responses": {
          "200": { "$ref": "#/components/responses/AlbumSummary" },
          "400": { "$ref": "#/components/responses/ValidationFailure" },
          "404": { "$ref": "#/components/responses/AlbumNotFound" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      },
      "delete": {
        "operationId": "deleteAlbum",
        "summary": "Delete an album and its owned composition",
        "responses": {
          "204": { "description": "Deleted; no response body" },
          "404": { "$ref": "#/components/responses/AlbumNotFound" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/api/albums/{id}/workspace": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceAlbumId" }],
      "get": {
        "operationId": "getAlbumWorkspace",
        "summary": "Read the complete chapter workspace",
        "description": "Separate from album metadata. Returns the album opening followed by chronological chapter blocks (first day, last day, chapter ID), with Home last. Each block starts with its opening followed by photo spreads in persisted order. Countries is the complete selectable reference catalog. photoInventories contains exactly one inventory for each chapter ID, including empty chapters; clients derive Synopsis/Cover from these same collections. Reads never initiate import. Inventory/composition failures return 500, not partial or empty-success data.",
        "responses": {
          "200": {
            "description": "Complete year-bearing workspace",
            "headers": {
              "Cache-Control": { "schema": { "const": "no-store" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Workspace" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/AlbumNotFound" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/api/albums/{id}/chapters": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceAlbumId" }],
      "post": {
        "operationId": "createChapter",
        "summary": "Create a vacation or Home chapter",
        "description": "Atomically saves metadata, country associations, default opening geometry and supplied chronological order. Home is unique and spans the album year. Vacation names are trimmed, nonblank and cannot be Home. Countries must identify distinct catalog entries. Source folders are unique within an album. The 65-interior-spread limit includes all openings and photo spreads but excludes Cover; creation at 64 adds its opening. Invalid input/conflicts return 400. After commit, schedules asynchronous photo processing without waiting for directory/image work; scheduling failed still returns 201 with the saved identity. Retry through photo Refresh, not repeated creation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "allOf": [
                      { "$ref": "#/components/schemas/VacationDetails" },
                      {
                        "type": "object",
                        "required": ["kind"],
                        "properties": { "kind": { "const": "vacation" } }
                      }
                    ]
                  },
                  {
                    "allOf": [
                      { "$ref": "#/components/schemas/HomeDetails" },
                      {
                        "type": "object",
                        "required": ["kind"],
                        "properties": { "kind": { "const": "home" } }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/ChapterIdentity" },
          "400": { "$ref": "#/components/responses/ValidationFailure" },
          "404": { "$ref": "#/components/responses/AlbumNotFound" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/api/albums/{id}/chapters/{chapterId}": {
      "parameters": [
        { "$ref": "#/components/parameters/WorkspaceAlbumId" },
        {
          "name": "chapterId",
          "in": "path",
          "required": true,
          "description": "Lowercase canonical UUID. Malformed, missing or foreign chapter targets return chapter_not_found.",
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "put": {
        "operationId": "updateChapter",
        "summary": "Update an owned chapter's metadata",
        "description": "The saved chapter type selects the details shape: vacation requires name, countries, start, end and sourceFolder; Home requires countries and sourceFolder and retains its year-derived period. No kind field is required or used to change type. Other fields are ignored. Atomically updates metadata, country associations and chronological positions while preserving chapter identity, description, templates, spread/slot IDs and geometry. A changed folder atomically clears previous photo/placement references and schedules processing after commit; unchanged folders return not-requested. Scheduling failed still returns 200 with the saved identity and offers Refresh-only retry. Conflicts/validation failures return 400 without changing persisted state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  { "$ref": "#/components/schemas/VacationDetails" },
                  { "$ref": "#/components/schemas/HomeDetails" }
                ],
                "description": "Use the shape belonging to the target's saved kind; the server resolves ownership and type before decoding details."
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/ChapterIdentity" },
          "400": { "$ref": "#/components/responses/ValidationFailure" },
          "404": {
            "description": "Malformed or missing album, or malformed, missing or foreign chapter",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": { "enum": ["album_not_found", "chapter_not_found"] }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/api/chapters/{chapterId}/photos": {
      "parameters": [{ "$ref": "#/components/parameters/PhotoChapterId" }],
      "get": {
        "operationId": "getChapterPhotos",
        "summary": "Read complete photos, authoritative counts and runtime processing feedback",
        "description": "Existing empty chapters return empty photos and zero counts. Reads do not scan originals or initiate generation. Photos are ordered by camera-local capture time ascending, undated last, then case-insensitive/exact filename and chapter ID. Source/storage paths are not exposed.",
        "responses": {
          "200": {
            "description": "Current chapter inventory",
            "headers": {
              "Cache-Control": { "schema": { "const": "no-store" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PhotoInventory" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/ChapterNotFound" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/api/chapters/{chapterId}/photos/refresh": {
      "parameters": [{ "$ref": "#/components/parameters/PhotoChapterId" }],
      "post": {
        "operationId": "refreshChapterPhotos",
        "summary": "Schedule chapter photo reconciliation",
        "description": "No request body. Reconciles immediate-folder JPEG additions, content-hash edits, removals and changed quality asynchronously. Overlapping requests coalesce. Scheduling is distinct from processing completion; a failed launch/read returns 500. Synopsis/Cover clients invoke this operation for each chapter.",
        "responses": {
          "202": {
            "description": "Scheduled or coalesced with current work",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["scheduling"],
                  "properties": {
                    "scheduling": { "enum": ["queued", "coalesced"] }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/ChapterNotFound" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/api/albums/{id}/photo-events": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceAlbumId" }],
      "get": {
        "operationId": "subscribeAlbumPhotoEvents",
        "summary": "Subscribe to chapter inventory and processing invalidations",
        "description": "Validates album existence before streaming. Register before subscribed (data: {}), then emit inventory-changed (data: {chapterId}) after committed photo or processing changes. Heartbeat comments arrive every 15 seconds. One stream per open browser workspace; subscribe before initial/reconnect workspace GET, buffer invalidations during catch-up, then reread affected chapters. Slow subscribers use bounded coalescing and never block processing. Opening/reconnecting never initiates import; no image bytes travel over SSE.",
        "responses": {
          "200": {
            "description": "Named Server-Sent Events with JSON data",
            "headers": {
              "Cache-Control": { "schema": { "const": "no-store" } },
              "X-Accel-Buffering": { "schema": { "const": "no" } }
            },
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" },
                "example": "event: subscribed\ndata: {}\n\nevent: inventory-changed\ndata: {\"chapterId\":\"6518a51c-bc7a-4015-b899-245c73a2103e\"}\n\n: heartbeat\n\n"
              }
            }
          },
          "404": { "$ref": "#/components/responses/AlbumNotFound" },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/thumbnails/{location}/{version}.jpg": {
      "parameters": [
        {
          "name": "location",
          "in": "path",
          "required": true,
          "description": "Lowercase canonical UUID naming an exclusive managed publication, not a photo lookup.",
          "schema": { "type": "string", "format": "uuid" }
        },
        {
          "name": "version",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        {
          "name": "If-None-Match",
          "in": "header",
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "operationId": "getThumbnail",
        "summary": "Read a supplied immutable managed-thumbnail URL",
        "description": "Serves only the managed thumbnail root, without a photo-metadata lookup or generation. Original files are never delivered. Malformed/traversal, missing-file and mismatched-version requests return 404.",
        "responses": {
          "200": {
            "description": "One JPEG within its selected preset; globally at most 2048px longest edge and 300,000 bytes",
            "headers": {
              "Cache-Control": {
                "schema": { "const": "private, max-age=31536000, immutable" }
              },
              "ETag": {
                "schema": { "type": "string" },
                "description": "Quoted content-version hash"
              }
            },
            "content": {
              "image/jpeg": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "304": { "$ref": "#/components/responses/ThumbnailNotModified" },
          "404": {
            "description": "Managed thumbnail not found; no regeneration"
          },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      },
      "head": {
        "operationId": "headThumbnail",
        "summary": "Read managed-thumbnail headers without a response body",
        "responses": {
          "200": {
            "description": "JPEG headers; no response body",
            "headers": {
              "Content-Type": { "schema": { "const": "image/jpeg" } },
              "Cache-Control": {
                "schema": { "const": "private, max-age=31536000, immutable" }
              },
              "ETag": { "schema": { "type": "string" } }
            }
          },
          "304": { "$ref": "#/components/responses/ThumbnailNotModified" },
          "404": {
            "description": "Malformed URL or managed thumbnail not found"
          },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    },
    "/api/templates/album-start": {
      "get": {
        "operationId": "listAlbumStartTemplates",
        "summary": "List the complete AlbumStart template catalog",
        "description": "Ascending template-ID order with slots in template order. Seeded geometry retains the legacy catalog's percentages of full spread width and height, without rescaling. Each template has photo slots and one right-hand synopsis text slot; clients supply no template ID when creating albums.",
        "responses": {
          "200": {
            "description": "Complete ordered catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["templates"],
                  "properties": {
                    "templates": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/components/schemas/AlbumStartTemplate"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServiceFailure" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PhotoChapterId": {
        "name": "chapterId",
        "in": "path",
        "required": true,
        "description": "Lowercase canonical UUID. Malformed or missing chapter targets return chapter_not_found.",
        "schema": { "type": "string", "format": "uuid" }
      },
      "WorkspaceAlbumId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Lowercase canonical UUID. Malformed and missing IDs return album_not_found.",
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "requestBodies": {
      "Title": {
        "required": true,
        "description": "A string title, trimmed before nonblank validation. Malformed JSON, missing or non-string titles, and blank trimmed titles return validation feedback.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["title"],
              "properties": { "title": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "responses": {
      "ChapterIdentity": {
        "description": "Persisted chapter identity and independent postcommit scheduling result; failed scheduling preserves the save",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["id", "scheduling"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "scheduling": {
                  "enum": ["queued", "coalesced", "not-requested", "failed"]
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "ChapterNotFound": {
        "description": "Malformed chapter ID or chapter not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["code"],
              "properties": { "code": { "const": "chapter_not_found" } },
              "additionalProperties": false
            }
          }
        }
      },
      "ThumbnailNotModified": {
        "description": "Matching content version; no response body",
        "headers": {
          "Cache-Control": {
            "schema": { "const": "private, max-age=31536000, immutable" }
          },
          "ETag": { "schema": { "type": "string" } }
        }
      },
      "AlbumSummary": {
        "description": "Album identity, required immutable year, title and immutable creation time",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AlbumSummary" }
          }
        }
      },
      "ValidationFailure": {
        "description": "Human-readable validation feedback",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["message"],
              "properties": { "message": { "type": "string", "minLength": 1 } },
              "additionalProperties": false
            }
          }
        }
      },
      "AlbumNotFound": {
        "description": "Malformed album ID or album not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["code"],
              "properties": { "code": { "const": "album_not_found" } },
              "additionalProperties": false
            }
          }
        }
      },
      "ServiceFailure": {
        "description": "Infrastructure failure or incomplete persisted composition",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["code"],
              "properties": { "code": { "const": "service_failure" } },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "schemas": {
      "AlbumYear": { "type": "integer", "minimum": 1900, "maximum": 2100 },
      "CountryIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "format": "uuid" },
        "description": "Distinct lowercase canonical UUIDs identifying records in the selectable country catalog."
      },
      "SourceFolder": {
        "type": "string",
        "minLength": 1,
        "pattern": "^/(?!.*[\\\\\\u0000])(?!(?:.*/)?\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
        "description": "Full backend-visible absolute path, unique within its album and preserved as supplied. Requires nonempty path segments; rejects the bare root, trailing or repeated separators, backslashes, NUL and dot or parent-traversal segments. It need not exist yet."
      },
      "HomeDetails": {
        "type": "object",
        "required": ["countries", "sourceFolder"],
        "properties": {
          "countries": { "$ref": "#/components/schemas/CountryIds" },
          "sourceFolder": { "$ref": "#/components/schemas/SourceFolder" }
        }
      },
      "VacationDetails": {
        "allOf": [
          { "$ref": "#/components/schemas/HomeDetails" },
          {
            "type": "object",
            "required": ["name", "start", "end"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Trimmed nonblank destination name, other than Home."
              },
              "start": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Inclusive first calendar day; trips may be outside the album year."
              },
              "end": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Inclusive last calendar day, not before start; same-day trips are valid."
              }
            }
          }
        ]
      },
      "Workspace": {
        "type": "object",
        "required": [
          "year",
          "photoRoot",
          "chapters",
          "spreads",
          "countries",
          "photoInventories"
        ],
        "properties": {
          "year": { "$ref": "#/components/schemas/AlbumYear" },
          "photoRoot": {
            "type": "string",
            "minLength": 1,
            "description": "Configured absolute root used for folder suggestions; the configuration default is /photos. Saved sourceFolder values are full paths, not relative to this value."
          },
          "chapters": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Chapter" }
          },
          "spreads": {
            "type": "array",
            "minItems": 1,
            "maxItems": 65,
            "items": { "$ref": "#/components/schemas/WorkspaceSpread" }
          },
          "countries": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/Country" }
          },
          "photoInventories": {
            "type": "object",
            "description": "Exactly one entry per chapter ID, including empty chapters; no foreign or missing keys.",
            "propertyNames": { "type": "string", "format": "uuid" },
            "additionalProperties": {
              "$ref": "#/components/schemas/PhotoInventory"
            }
          }
        }
      },
      "PhotoInventory": {
        "type": "object",
        "required": ["photos", "counts", "processing"],
        "properties": {
          "photos": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Photo" },
            "description": "Complete photos with unique identities in chronological order."
          },
          "counts": {
            "type": "object",
            "required": ["unplaced", "total"],
            "description": "total equals photos.length; unplaced is derived from authoritative placements and never exceeds total.",
            "properties": {
              "unplaced": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 }
            }
          },
          "processing": { "$ref": "#/components/schemas/PhotoProcessing" }
        }
      },
      "Photo": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "capturedLocal",
          "width",
          "height",
          "caption",
          "thumbnail"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "filename": { "type": "string", "minLength": 1 },
          "capturedLocal": {
            "type": ["string", "null"],
            "description": "Camera-local EXIF date/time, without timezone. Missing/invalid dates are null; never filesystem time.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?$"
          },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "caption": { "type": ["string", "null"] },
          "thumbnail": {
            "type": "object",
            "required": ["url", "width", "height"],
            "properties": {
              "url": {
                "type": "string",
                "description": "Supplied versioned application URL. Use unchanged for lazy loading/cache reuse; never add cache-busting parameters.",
                "pattern": "^/thumbnails/[0-9a-f-]{36}/[0-9a-f]{64}\\.jpg$"
              },
              "width": { "type": "integer", "minimum": 1, "maximum": 2048 },
              "height": { "type": "integer", "minimum": 1, "maximum": 2048 }
            }
          }
        }
      },
      "PhotoProcessing": {
        "type": "object",
        "required": ["state", "unsupportedCount", "skippedCount", "issues"],
        "description": "Transient chapter-local feedback resets to idle on restart, independently of saved photos. completed may include unsupported/undecodable/unstable skips; directory/read/encoding/storage/database/cleanup/scheduling failures are explicit.",
        "properties": {
          "state": {
            "enum": ["idle", "queued", "running", "completed", "failed"]
          },
          "unsupportedCount": { "type": "integer", "minimum": 0 },
          "skippedCount": { "type": "integer", "minimum": 0 },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stage", "code", "filename"],
              "properties": {
                "stage": {
                  "enum": [
                    "discovery",
                    "read",
                    "generation",
                    "storage",
                    "persistence",
                    "cleanup",
                    "scheduling"
                  ]
                },
                "code": {
                  "enum": [
                    "unreadable_source",
                    "undecodable",
                    "unstable",
                    "encoding_failed",
                    "storage_failed",
                    "persistence_failed",
                    "cleanup_failed",
                    "scheduling_failed"
                  ]
                },
                "filename": {
                  "type": ["string", "null"],
                  "description": "Immediate source filename, or null for a chapter-wide issue. Codes never expose internal paths or exception details."
                }
              }
            }
          }
        }
      },
      "Country": {
        "type": "object",
        "required": ["id", "name", "code"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "pattern": "^[A-Z]{2}$" }
        }
      },
      "Chapter": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "countries",
          "start",
          "end",
          "sourceFolder",
          "description"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "enum": ["vacation", "home"] },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Destination name; Home for a Home chapter."
          },
          "countries": { "$ref": "#/components/schemas/CountryIds" },
          "start": {
            "type": "string",
            "format": "date",
            "description": "Inclusive first day; January 1 of the album year for Home."
          },
          "end": {
            "type": "string",
            "format": "date",
            "description": "Inclusive last day; December 31 of the album year for Home."
          },
          "sourceFolder": { "$ref": "#/components/schemas/SourceFolder" },
          "description": {
            "type": "string",
            "description": "Persisted chapter owner text, including the empty string."
          }
        }
      },
      "WorkspaceSpread": {
        "type": "object",
        "required": ["id", "chapter", "kind", "slots"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "chapter": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "Null for the album opening; otherwise the owning chapter ID."
          },
          "kind": { "enum": ["album_start", "chapter_start", "photos_only"] },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/WorkspaceSlot" },
            "description": "Photo slots followed by the owner-text slot for openings; photo slots only for photos_only. Geometry is persisted percentages of the full spread axes, not normalized to occupied bounds."
          }
        }
      },
      "WorkspaceSlot": {
        "allOf": [
          { "$ref": "#/components/schemas/TemplateSlot" },
          {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "type": "string", "format": "uuid" } }
          }
        ]
      },
      "AlbumSummary": {
        "type": "object",
        "required": ["id", "year", "title", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "year": { "$ref": "#/components/schemas/AlbumYear" },
          "title": { "type": "string", "minLength": 1 },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Immutable UTC instant"
          }
        }
      },
      "AlbumMetadata": {
        "allOf": [
          { "$ref": "#/components/schemas/AlbumSummary" },
          {
            "type": "object",
            "required": ["synopsis"],
            "properties": { "synopsis": { "type": "string" } }
          }
        ],
        "unevaluatedProperties": false
      },
      "AlbumPage": {
        "type": "object",
        "required": ["albums", "page", "pageSize", "totalAlbums", "totalPages"],
        "properties": {
          "albums": {
            "type": "array",
            "maxItems": 6,
            "items": { "$ref": "#/components/schemas/AlbumSummary" }
          },
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "const": 6 },
          "totalAlbums": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer", "minimum": 0 }
        }
      },
      "AlbumStartTemplate": {
        "type": "object",
        "required": ["id", "name", "slots"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1 },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/TemplateSlot" }
          }
        }
      },
      "TemplateSlot": {
        "type": "object",
        "required": ["kind", "x", "y", "width", "height"],
        "properties": {
          "kind": { "enum": ["photo", "text"] },
          "x": { "type": "number", "minimum": 0 },
          "y": { "type": "number", "minimum": 0 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
